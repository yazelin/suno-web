# API 金鑰（逗號分隔多把；沒設＝開放，僅限本機開發）
API_KEYS=

# 服務埠
PORT=8071

# 部署時務必 true
HEADLESS=true

# 音檔保留天數
AUDIO_RETENTION_DAYS=14

# 以下都有預設值，要改才取消註解
# HOST=0.0.0.0
# QUEUE_MAX_SIZE=10
# DEFAULT_TIMEOUT=600
# PROFILE_DIR=/home/YOU/.suno-web/profiles
# GENERATED_DIR=/home/YOU/.suno-web/generated
# SUNO_URL=https://suno.com/create
# STEALTH_TIMEZONE=Asia/Taipei

# 真 Chrome 的執行檔。沒裝在標準位置就指過去（例如解 deb 到家目錄的情況）
# CHROME_BINARY=/home/ct/opt/chrome/opt/google/chrome/chrome

# 沙箱起不來的機器才打開（解 deb 到家目錄的情況）
# CHROME_NO_SANDBOX=true

# 管理台（對外開放前一定要改掉這兩個）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
# 反代到子路徑時設，例如 nginx 的 location /suno-web/
# ADMIN_URL_PREFIX=/suno-web

# 下載檔 ID3 的署名（選用）
# TPE1 是「演出者」，Suno 官方下載寫的是帳號擁有者；未設則寫 Suno
TAG_ARTIST=
# TENC（encoded by），工具名該待的欄位；未設則寫 suno-web
TAG_ENCODER=
